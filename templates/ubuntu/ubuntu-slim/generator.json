        "provisioners": [
          {
            "type": "shell",
            "execute_command": "sudo sh -c '{{ .Vars }} {{ .Path }}'",
            "inline": [
              "mkdir -p /imagegeneration",
              "chmod 777 /imagegeneration"
            ]
          },
          {
            "type": "file",
            "destination": "${local.build_script_folder}",
