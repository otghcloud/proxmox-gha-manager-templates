  "template_id": "ubuntu-slim",
  "display_name": "Ubuntu Slim",
  "upstream_template": null,
  "packer": {
    "source": "source.proxmox-iso.ubuntu-slim",
    "name": "ubuntu-slim"
  },
  "rewrites": [],
