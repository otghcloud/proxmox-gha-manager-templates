  "stages": {
    "prepare-image-generation": {
      "name": "Prepare the image generation workspace",
      "match": {
        "inline_contains": "mkdir -p /imagegeneration"
      }
    },
    "configure-github-api-wrapper": {
      "name": "Configure GitHub API rate-limit wrapper",
      "match": {
        "inline_contains": "install -m 0755 /tmp/github-api-curl-wrapper.sh"
      }
    },
    "install-actions-runner": {
      "name": "Install the GitHub Actions runner",
      "match": {
        "inline_contains": "sudo mkdir -p /opt/actions-runner"
      }
    },
    "install-ssh-public-key": {
      "name": "Install SSH public key",
      "match": {
        "inline_contains": "SSH_PUBLIC_KEY"
      }
    },
    "cleanup-template": {
      "name": "Cleanup prior to Proxmox template creation",
      "match": {
        "inline_contains": "sudo cloud-init clean"
      }
    },
    "upload-build": {
      "name": "Upload build scripts"
    },
    "upload-helpers": {
      "name": "Upload helper scripts"
    },
    "upload-toolsets": {
      "name": "Upload the toolset definitions"
    },
    "upload-github-api-curl-wrapper": {
      "name": "Upload GitHub API curl wrapper"
    }
  },
  "groups": [
    {
      "id": "configure",
      "label": "Configure",
      "starts_at": "prepare-image-generation"
    },
    {
      "id": "toolset",
      "label": "Runner toolset",
      "starts_at": "configure-apt-sources"
    },
    {
      "id": "finalise",
      "label": "Finalise",
      "starts_at": "install-actions-runner"
    },
    {
      "id": "cleanup",
      "label": "Cleanup",
      "starts_at": "cleanup-template"
    }
  ],
  "cloudimg": {
    "locals": {
      "ubuntu_slim_root": "@runner_images",
      "helper_script_folder": "/imagegeneration/helpers",
      "build_script_folder": "/imagegeneration/build",
      "installer_script_folder": "/imagegeneration/toolsets",
      "image_version": "dev",
      "image_os": "ubuntu24-slim",
      "imagedata_name": "ubuntu:24.04-slim"
    },
    "vars": {
      "root": "@template",
      "github_api_token": "$GH_API_TOKEN",
      "github_api_min_remaining": "$GH_API_MIN_REMAINING",
      "github_api_wait_buffer_seconds": "$GH_API_WAIT_BUFFER_SECONDS",
      "ssh_username": "\"$SSH_USERNAME\"",
      "ssh_public_key": "$SSH_PUBLIC_KEY"
    },
    "preamble_exports": {
      "SSH_USERNAME": "\"$(id -un)\""
    },
    "catalog_environment": {
      "GH_API_TOKEN": "github_api_token",
      "GH_API_MIN_REMAINING": "github_api_min_remaining",
      "GH_API_WAIT_BUFFER_SECONDS": "github_api_wait_buffer_seconds"
    },
    "source_roots": [
      {
        "prefix": "@runner_images/",
        "source_root": null
      },
      {
        "prefix": "@template/../../../../",
        "source_root": "catalog_root",
        "executable": true
      }
    ],
    "script_destinations": {
      "@runner_images/scripts/build/": "/imagegeneration/build",
      "@runner_images/scripts/helpers/": "/imagegeneration/helpers"
    },
    "upload_destinations": {},
    "skip_stages": [
      "install-ssh-public-key"
    ],
    "no_script_stages": [],
    "move_stages": [],
    "stage_overrides": {
      "prepare-image-generation": {
        "append": [
          "sudo mkdir -p /imagegeneration/helpers /imagegeneration/build /imagegeneration/toolsets"
        ]
      },
      "install-actions-runner": {
        "prepend": [
          "echo \"==> Waiting for any in-progress apt/dpkg lock to clear\"",
          "for _ in $(seq 1 60); do",
          "    if ! sudo fuser /var/lib/dpkg/lock-frontend >/dev/null 2>&1; then",
          "        break",
          "    fi",
          "    sleep 1",
          "done"
        ]
      }
    }
  }
}
