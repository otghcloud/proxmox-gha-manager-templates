{
    "schema_version": 3,
    "builder": "cloudimg",
    "template_id": "ubuntu-slim",
    "display_name": "Ubuntu Slim",
    "stage_groups": [
        {
            "id": "configure",
            "label": "Configure",
            "display_order": 1,
            "stages": [
                {
                    "id": "prepare-image-generation",
                    "name": "Prepare the image generation workspace",
                    "marker": "[image-builder:stage:prepare-image-generation]",
                    "description": "Prepare the image generation workspace",
                    "required": true,
                    "sequence": 1,
                    "script": "stage-scripts/prepare-image-generation.sh"
                },
                {
                    "id": "upload-build",
                    "name": "Upload build scripts",
                    "marker": "[image-builder:stage:upload-build]",
                    "description": "Upload build scripts",
                    "required": true,
                    "sequence": 2,
                    "uploads": [
                        {
                            "source": "scripts/build",
                            "destination": "/imagegeneration/build"
                        }
                    ]
                },
                {
                    "id": "upload-helpers",
                    "name": "Upload helper scripts",
                    "marker": "[image-builder:stage:upload-helpers]",
                    "description": "Upload helper scripts",
                    "required": true,
                    "sequence": 3,
                    "uploads": [
                        {
                            "source": "scripts/helpers",
                            "destination": "/imagegeneration/helpers"
                        }
                    ]
                },
                {
                    "id": "upload-toolsets",
                    "name": "Upload the toolset definitions",
                    "marker": "[image-builder:stage:upload-toolsets]",
                    "description": "Upload the toolset definitions",
                    "required": true,
                    "sequence": 4,
                    "uploads": [
                        {
                            "source": "toolsets",
                            "destination": "/imagegeneration/toolsets"
                        }
                    ]
                },
                {
                    "id": "upload-github-api-curl-wrapper",
                    "name": "Upload GitHub API curl wrapper",
                    "marker": "[image-builder:stage:upload-github-api-curl-wrapper]",
                    "description": "Upload GitHub API curl wrapper",
                    "required": true,
                    "sequence": 5,
                    "uploads": [
                        {
                            "source": "scripts/github-api-curl-wrapper.sh",
                            "source_root": "catalog_root",
                            "destination": "/tmp/github-api-curl-wrapper.sh",
                            "mode": 493
                        }
                    ]
                },
                {
                    "id": "configure-github-api-wrapper",
                    "name": "Configure GitHub API rate-limit wrapper",
                    "marker": "[image-builder:stage:configure-github-api-wrapper]",
                    "description": "Configure GitHub API rate-limit wrapper",
                    "required": true,
                    "sequence": 6,
                    "environment": {
                        "GH_API_TOKEN": "github_api_token",
                        "GH_API_MIN_REMAINING": "github_api_min_remaining",
                        "GH_API_WAIT_BUFFER_SECONDS": "github_api_wait_buffer_seconds"
                    },
                    "script": "stage-scripts/configure-github-api-wrapper.sh"
                }
            ]
        },
        {
            "id": "toolset",
            "label": "Runner toolset",
            "display_order": 2,
            "stages": [
                {
                    "id": "configure-apt-sources",
                    "name": "Configure apt sources",
                    "marker": "[image-builder:stage:configure-apt-sources]",
                    "description": "Configure apt sources",
                    "required": true,
                    "sequence": 7,
                    "script": "stage-scripts/configure-apt-sources.sh"
                },
                {
                    "id": "configure-apt",
                    "name": "Configure apt",
                    "marker": "[image-builder:stage:configure-apt]",
                    "description": "Configure apt",
                    "required": true,
                    "sequence": 8,
                    "script": "stage-scripts/configure-apt.sh"
                },
                {
                    "id": "install-apt-vital",
                    "name": "Install apt vital",
                    "marker": "[image-builder:stage:install-apt-vital]",
                    "description": "Install apt vital",
                    "required": true,
                    "sequence": 9,
                    "script": "stage-scripts/install-apt-vital.sh"
                },
                {
                    "id": "install-ms-repos",
